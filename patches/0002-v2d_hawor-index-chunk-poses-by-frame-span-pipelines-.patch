From 0b2c8f806f7d84167e5f7a182bddf02d06e772a8 Mon Sep 17 00:00:00 2001
From: kghasemz <kghasemz@ualberta.ca>
Date: Sat, 26 Sep 2026 13:20:44 -0600
Subject: [PATCH 2/2] v2d_hawor: index chunk poses by frame span; pipelines:
 optional FoundationPose downscale

HaWoR chunk arrays cover the chunk's contiguous frame span while frame_chunks
lists only detected frames, which crashed the export with a reshape error.
V2D_FP_TARGET_WH lets FoundationPose run downscaled (full-res registration of
large objects exhausts a 48 GB GPU).
---
 reconstruction/modules/v2d_hawor/lib/run_hawor.py   | 13 +++++++++++++
 .../modules/v2d_pipelines/run_ego_wilor.py          |  5 +++++
 2 files changed, 18 insertions(+)

diff --git a/reconstruction/modules/v2d_hawor/lib/run_hawor.py b/reconstruction/modules/v2d_hawor/lib/run_hawor.py
index 09fd7f0..2f640a1 100644
--- a/reconstruction/modules/v2d_hawor/lib/run_hawor.py
+++ b/reconstruction/modules/v2d_hawor/lib/run_hawor.py
@@ -382,6 +382,19 @@ def _export_camera_space_tracks(
             hand_rot = _as_time_array(data["init_hand_pose"])
             trans = _as_time_array(data["init_trans"])
             betas = _as_time_array(data["init_betas"])
+            n_data = len(trans)
+            if n_data != len(frames):
+                # A chunk's arrays cover its whole contiguous frame span, while
+                # frame_chunks lists only frames with a detection. Index by span;
+                # span frames without a bbox are skipped below as before.
+                if frames and n_data == frames[-1] - frames[0] + 1:
+                    frames = list(range(frames[0], frames[-1] + 1))
+                else:
+                    print(f"Warning: HaWoR chunk {chunk_i} (hand {hand_idx}) has {n_data} poses for "
+                          f"{len(frames)} frames; keeping the first {min(n_data, len(frames))}")
+                    m = min(n_data, len(frames))
+                    frames, root_rot, hand_rot, trans = frames[:m], root_rot[:m], hand_rot[:m], trans[:m]
+                    betas = betas[:m] if betas.ndim > 1 and len(betas) >= m else betas
             root_aa = _rotmat_to_axis_angle(root_rot).reshape(len(frames), 3)
             hand_aa = _rotmat_to_axis_angle(hand_rot).reshape(len(frames), -1, 3)
             if not is_right:
diff --git a/reconstruction/modules/v2d_pipelines/run_ego_wilor.py b/reconstruction/modules/v2d_pipelines/run_ego_wilor.py
index 99f5480..7c963a8 100644
--- a/reconstruction/modules/v2d_pipelines/run_ego_wilor.py
+++ b/reconstruction/modules/v2d_pipelines/run_ego_wilor.py
@@ -1147,6 +1147,11 @@ def run_ego_wilor(
                 reference_frame        = reference_frame,
                 mask_depth             = True,
                 reregister_iou_thresh  = reregister_iou_thresh if reregister_iou_thresh else None,
+                # Full-res (e.g. 2028x1520) registration of large objects can exhaust
+                # a 48 GB GPU; V2D_FP_TARGET_WH="WxH" runs FoundationPose downscaled
+                # (depth/masks/intrinsics are rescaled consistently; poses are metric).
+                target_width           = int(os.environ["V2D_FP_TARGET_WH"].split("x")[0]) if os.environ.get("V2D_FP_TARGET_WH") else None,
+                target_height          = int(os.environ["V2D_FP_TARGET_WH"].split("x")[1]) if os.environ.get("V2D_FP_TARGET_WH") else None,
                 dev                    = dev,
             )
 
