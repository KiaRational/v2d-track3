Bootstrap: docker
From: nvidia/cuda:12.1.1-cudnn8-devel-ubuntu22.04
# SAM 3D Objects (image + mask [+ metric pointmap] -> textured mesh) without conda: python-build-standalone 3.11,
# torch 2.5.1 cu121, pytorch3d / gsplat built from the pinned commits for L40S (sm_89), flash-attn and kaolin wheels.
# Repo bound at run time (/scratch/kghasemz/v2d/third_party/sam-3d-objects); checkpoints in its checkpoints/hf.
# Build: sbatch --time=4:00:00 --cpus-per-task=32 build_def_sif.sbatch defs/sam3d_objects.def

%files
    /scratch/kghasemz/v2d/third_party/sam-3d-objects/requirements.txt /opt/s3d_requirements.txt

%post
    export DEBIAN_FRONTEND=noninteractive
    apt-get update && apt-get install -y --no-install-recommends curl ca-certificates git build-essential ninja-build \
        libgl1 libglib2.0-0 libegl1 libgomp1 libxrender1 libxi6 libxkbcommon0 libsm6 ffmpeg && rm -rf /var/lib/apt/lists/*
    curl -sSL -o /tmp/py.tgz \
        https://github.com/astral-sh/python-build-standalone/releases/download/20241016/cpython-3.11.10+20241016-x86_64-unknown-linux-gnu-install_only.tar.gz
    tar -xzf /tmp/py.tgz -C /opt && rm /tmp/py.tgz
    export PATH=/opt/python/bin:$PATH
    ln -sf /opt/python/bin/python3.11 /usr/local/bin/python
    python -m pip install --no-cache-dir -U pip setuptools wheel
    python -m pip install --no-cache-dir torch==2.5.1 torchvision==0.20.1 torchaudio==2.5.1 \
        --index-url https://download.pytorch.org/whl/cu121
    # keep torch 2.5.1+cu121 for every later install (MoGe and others would pull a newer CUDA-13 torch)
    printf "torch==2.5.1\ntorchvision==0.20.1\ntorchaudio==2.5.1\nnumpy<2\n" > /opt/torch_pins.txt
    export PIP_CONSTRAINT=/opt/torch_pins.txt
    # repo requirements minus training/cloud/notebook-only packages that need extra toolchains
    grep -viE '^(auto_gptq|bitsandbytes|bpy|sagemaker|jupyter|conda-pack|mosaicml-streaming|pymongo|hdfs|torchaudio|nvidia-pyindex|pip-system-certs|cuda-python|nvidia-cuda-nvcc|optimum|peft|librosa|sentence-transformers|black|flake8|autoflake|pytest|pdoc3|Flask|polyscope|panda3d-gltf|decord)' \
        /opt/s3d_requirements.txt > /tmp/req.txt
    python -m pip install --no-cache-dir -r /tmp/req.txt
    python -m pip install --no-cache-dir einops xformers==0.0.28.post3 --index-url https://download.pytorch.org/whl/cu121 \
        --extra-index-url https://pypi.org/simple
    # python-build-standalone records clang in sysconfig; build extensions with the image gcc instead
    export CC=gcc CXX=g++ LDSHARED="gcc -pthread -shared" LDCXXSHARED="g++ -pthread -shared"
    export TORCH_CUDA_ARCH_LIST="8.9" FORCE_CUDA=1 MAX_JOBS=24 CUDA_HOME=/usr/local/cuda
    python -m pip install --no-cache-dir --no-build-isolation \
        "git+https://github.com/facebookresearch/pytorch3d.git@75ebeeaea0908c5527e7b1e305fbc7681382db47"
    python -m pip install --no-cache-dir --no-build-isolation \
        "git+https://github.com/nerfstudio-project/gsplat.git@2323de5905d5e90e035f792fe65bad0fedd413e7"
    python -m pip install --no-cache-dir \
        https://github.com/Dao-AILab/flash-attention/releases/download/v2.8.3/flash_attn-2.8.3+cu12torch2.5cxx11abiFALSE-cp311-cp311-linux_x86_64.whl
    python -m pip install --no-cache-dir kaolin==0.17.0 \
        -f https://nvidia-kaolin.s3.us-east-2.amazonaws.com/torch-2.5.1_cu121.html
    python -m pip install --no-cache-dir seaborn==0.13.2 "huggingface-hub[cli]<1.0" "plyfile<1.1" pyvista xatlas plotly gradio==5.49.0
    # MoGe (only for the pointmap when none is given): no deps, its newer releases need triton > torch 2.5.1's
    python -m pip install --no-cache-dir "setuptools<81"  # lightning imports pkg_resources
    python -m pip install --no-cache-dir --no-deps "git+https://github.com/microsoft/MoGe.git@a8c37341bc0325ca99b9d57981cc3bb2bd3e255b"
    python -m pip install --no-cache-dir --no-deps "git+https://github.com/EasternJournalist/utils3d.git@3913c65d81e05e47b9f367250cf8c0f7462a0900"  # pins of sam-3d-objects requirements.txt / that MoGe commit
    python -m pip install --no-cache-dir --no-build-isolation "git+https://github.com/NVlabs/nvdiffrast.git"
    # hydra 1.3.2 patch (facebookresearch/hydra PR 2863), as patching/hydra does
    curl -sSL -o "$(python -c "import hydra,os;print(os.path.dirname(hydra.__file__))")/core/utils.py" \
        https://raw.githubusercontent.com/gleize/hydra/78f00766b5f37672aa7232ebbf01bdd74246bd60/hydra/core/utils.py
    python -c "import torch, pytorch3d, gsplat, kaolin, flash_attn, spconv; print('ok', torch.__version__)"

%environment
    export PATH=/opt/python/bin:$PATH PYTHONNOUSERSITE=1
