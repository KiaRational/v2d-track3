Bootstrap: docker
From: nvidia/cuda:12.1.1-cudnn8-devel-ubuntu22.04
# HaPTIC (4D hand trajectory from monocular video, github.com/judyye/haptic) inference runtime:
# Python 3.10 + torch 2.1.1 cu121 + pytorch3d v0.7.5 built from source for L40S (sm_89; the fbaipublicfiles wheel
# index is blocked by the cluster proxy) + xformers 0.0.23.
# Their detectron2/ViTPose/mmcv person+keypoint detector is NOT installed: we feed boxes from our own
# stereo hand fits (det.pkl), so only the model path is needed. The repo itself is bound at run time.
# Build: sbatch build_def_sif.sbatch defs/haptic.def

%post
    export DEBIAN_FRONTEND=noninteractive
    apt-get update && apt-get install -y --no-install-recommends python3.10 python3.10-dev python3-pip git \
        libgl1 libglib2.0-0 libegl1 libgomp1 ffmpeg && rm -rf /var/lib/apt/lists/*
    ln -sf /usr/bin/python3.10 /usr/bin/python
    python -m pip install --no-cache-dir -U pip setuptools wheel
    python -m pip install --no-cache-dir torch==2.1.1 torchvision==0.16.1 torchaudio==2.1.1 \
        --index-url https://download.pytorch.org/whl/cu121
    printf "torch==2.1.1\ntorchvision==0.16.1\ntorchaudio==2.1.1\nnumpy==1.26.4\n" > /opt/torch_pins.txt
    export PIP_CONSTRAINT=/opt/torch_pins.txt
    python -m pip install --no-cache-dir "numpy==1.26.4" fvcore iopath
    export CC=gcc CXX=g++ TORCH_CUDA_ARCH_LIST="8.9" FORCE_CUDA=1 MAX_JOBS=16 CUDA_HOME=/usr/local/cuda
    python -m pip install --no-cache-dir --no-build-isolation \
        "git+https://github.com/facebookresearch/pytorch3d.git@v0.7.5"
    python -m pip install --no-cache-dir "numpy==1.26.4" opencv-python-headless pyrender pytorch-lightning==2.1.3 \
        scikit-image smplx==0.1.28 yacs timm einops pandas hydra-core omegaconf webdataset pyrootutils rich \
        wandb plotly trimesh imageio imageio-ffmpeg scipy xformers==0.0.23 \
        matplotlib scikit-video tqdm braceexpand pyyaml
    # chumpy's setup.py imports pip: no build isolation
    python -m pip install --no-cache-dir --no-build-isolation "chumpy @ git+https://github.com/mattloper/chumpy" \
        "manopth @ git+https://github.com/hassony2/manopth.git"
    # chumpy imports numpy aliases removed in numpy>=1.24
    CH=$(python -c "import importlib.util as u; print(u.find_spec('chumpy').submodule_search_locations[0])")
    sed -i 's/^from numpy import bool, int, float, complex, object, unicode, str, nan, inf/from numpy import nan, inf/' "$CH/__init__.py"
    python -c "import torch, pytorch3d, xformers, smplx, manopth, chumpy, pytorch_lightning; print(torch.__version__)"

%environment
    export PYTHONNOUSERSITE=1
    export PYOPENGL_PLATFORM=egl
